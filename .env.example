# Semua variabel ini opsional dan hanya dibaca server (api/ws.js).
#
# REDIS_URL diisi otomatis oleh Vercel saat kamu menambahkan Redis dari Marketplace/Storage.
# Isi manual hanya kalau mau menguji Redis saat dev lokal (default dev: state di memori).
# REDIS_URL=rediss://default:sandi@host:6379
#
# Batasi situs yang boleh membuka WebSocket (pisah koma). Kosong = semua boleh.
# ALLOWED_ORIGINS=gaple.example.com,*.vercel.app
